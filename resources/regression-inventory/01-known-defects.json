    {
      "id": "eliminated_recommendation_no_positional_fallback",
      "title": "An eliminated recommendation leaves no positional winner",
      "review_status": "maintainer_reviewed",
      "language": "en",
      "categories": ["eliminated_recommendation"],
      "rationale": "Reproduces the array-order fallback when the model recommendation is eliminated and two material routes remain.",
      "cases": [{
        "id": "eliminated_recommendation_no_positional_fallback_original",
        "provenance": "original",
        "language": "en",
        "requirement": "Resolve the feasible foundation after the recommended route fails a hard constraint.",
        "input": {
          "kind": "route_resolution",
          "routes": [
            { "id": "invalid_recommended", "pattern": "static_demo", "consequence_group": "invalid", "satisfies_hard_constraints": false, "dominated": false, "business_owned": false, "durable_tradeoff": false },
            { "id": "managed_route", "pattern": "managed_modular_monolith", "consequence_group": "low_operations", "satisfies_hard_constraints": true, "dominated": false, "business_owned": false, "durable_tradeoff": false },
            { "id": "self_hosted_route", "pattern": "self_hosted_modular_monolith", "consequence_group": "deployment_control", "satisfies_hard_constraints": true, "dominated": false, "business_owned": false, "durable_tradeoff": false }
          ],
          "recommended_route_id": "invalid_recommended",
          "critical_question_key": null
        },
        "expected": { "interaction_modes": ["abstain"], "prohibited_route_ids": ["invalid_recommended"], "abstention_reason": "no_deterministic_winner", "required_elimination_reasons": ["hard_constraint"] }
      }]
    },
    {
      "id": "three_route_ambiguity_abstains",
      "title": "Three material routes do not silently become a decision",
      "review_status": "maintainer_reviewed",
      "language": "en",
      "categories": ["three_or_more_routes"],
      "rationale": "Reproduces the legacy exact-three-route fall-through to decide.",
      "cases": [{
        "id": "three_route_ambiguity_abstains_original",
        "provenance": "original",
        "language": "en",
        "requirement": "Three feasible foundations have materially different business consequences and no known discriminator.",
        "input": {
          "kind": "route_resolution",
          "routes": [
            { "id": "managed_route", "pattern": "managed_modular_monolith", "consequence_group": "low_operations", "satisfies_hard_constraints": true, "dominated": false, "business_owned": true, "durable_tradeoff": true },
            { "id": "api_route", "pattern": "separated_api_monolith", "consequence_group": "multiple_clients", "satisfies_hard_constraints": true, "dominated": false, "business_owned": true, "durable_tradeoff": true },
            { "id": "self_hosted_route", "pattern": "self_hosted_modular_monolith", "consequence_group": "deployment_control", "satisfies_hard_constraints": true, "dominated": false, "business_owned": true, "durable_tradeoff": true }
          ],
          "recommended_route_id": "managed_route",
          "critical_question_key": null
        },
        "expected": { "interaction_modes": ["abstain"], "abstention_reason": "too_many_material_routes", "required_trace_ids": ["three_material_route_groups"] }
      }]
    }
  ]
}
