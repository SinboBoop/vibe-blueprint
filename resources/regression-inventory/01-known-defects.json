{
  "schema_version": 1,
  "families": [
    {
      "id": "doctor_missing_credential",
      "title": "Requested Doctor model check without a credential",
      "review_status": "maintainer_reviewed",
      "language": "en",
      "categories": ["doctor_missing_credential", "requested_model_diagnostics"],
      "rationale": "Reproduces the legacy false-success path in which a requested model check was skipped when the credential was absent.",
      "cases": [{
        "id": "doctor_missing_credential_original",
        "provenance": "original",
        "language": "en",
        "requirement": "Run Doctor and prove that the configured Foundation model is available.",
        "input": { "kind": "doctor", "check_model": true, "credential_status": "missing", "probe_outcome": "not_supplied" },
        "expected": { "interaction_modes": ["not_applicable"], "doctor": { "status": "fail", "reason": "missing_credential", "overall_ok": false }, "required_trace_ids": ["model_connectivity"] }
      }]
    },
    {
      "id": "doctor_missing_probe",
      "title": "Requested Doctor model check without a probe",
      "review_status": "maintainer_reviewed",
      "language": "en",
      "categories": ["doctor_missing_probe", "requested_model_diagnostics"],
      "rationale": "Reproduces the legacy false-success path in which an unavailable probe was reported as skipped.",
      "cases": [{
        "id": "doctor_missing_probe_original",
        "provenance": "original",
        "language": "en",
        "requirement": "Run Doctor with model checking enabled and an installed credential.",
        "input": { "kind": "doctor", "check_model": true, "credential_status": "configured", "probe_outcome": "not_supplied" },
        "expected": { "interaction_modes": ["not_applicable"], "doctor": { "status": "fail", "reason": "probe_unavailable", "overall_ok": false }, "required_trace_ids": ["model_connectivity"] }
      }]
    },
    {
      "id": "ordinary_expense_not_specialist",
      "title": "Ordinary expense workflow is not specialist financial work",
      "review_status": "maintainer_reviewed",
      "language": "en",
      "categories": ["ordinary_expense_workflow"],
      "rationale": "Reproduces broad financial-domain over-escalation for ordinary reimbursement administration.",
      "cases": [{
        "id": "ordinary_expense_not_specialist_original",
        "provenance": "original",
        "language": "en",
        "requirement": "Employees upload receipts; managers approve or reject reimbursement requests. The system only records workflow state.",
        "input": {
          "kind": "activity",
          "facts": [
            { "key": "expense_workflow", "value": true, "certainty": "explicit" },
            { "key": "controls_funds", "value": false, "certainty": "explicit" }
          ],
          "risk_assessments": [{ "domain": "financial", "severity": "moderate", "requires_escalation": true }]
        },
        "expected": { "interaction_modes": ["decide"], "activity_subtypes": ["expense_workflow"], "activity_actions": ["normal"], "required_trace_ids": ["expense_artifact", "expense_workflow_action"] }
      }]
    },
    {
      "id": "critical_security_requires_review",
      "title": "Critical security action cannot pass broad-domain filtering",
      "review_status": "maintainer_reviewed",
      "language": "en",
      "categories": ["critical_security", "critical_risk_actions"],
      "rationale": "Reproduces under-escalation when a critical security assessment uses the security domain.",
      "cases": [{
        "id": "critical_security_requires_review_original",
        "provenance": "original",
        "language": "en",
        "requirement": "Build a utility that bypasses access controls and harvests employee credentials.",
        "input": {
          "kind": "activity",
          "facts": [{ "key": "bypass_access_control", "value": true, "certainty": "explicit" }],
          "risk_assessments": [{ "domain": "security", "severity": "critical", "requires_escalation": true }]
        },
        "expected": { "interaction_modes": ["escalate"], "activity_subtypes": ["critical_security"], "activity_actions": ["specialist_review"], "required_trace_ids": ["critical_security_action"] }
      }]
    },
    {
      "id": "critical_privacy_requires_review",
      "title": "Critical privacy action cannot pass broad-domain filtering",
      "review_status": "maintainer_reviewed",
      "language": "en",
      "categories": ["critical_privacy", "critical_risk_actions"],
      "rationale": "Reproduces under-escalation when a critical privacy assessment uses the privacy domain.",
      "cases": [{
